+/* ZyDeck: the output as it runs (PaOboe_GetOutputStatus), and its queue: the size asked for (PaOboe_SetOutputQueueBursts)
+ * at a new stream's first callback (a reopened one too: a new route), then a burst more at each underrun, up to 50 ms,
+ * as Oboe's LatencyTuner does. TuneOutput() runs in the output callback: true if there was an underrun since the last. */
+static std::atomic<int> g_queueBursts{0};
+static std::atomic<int> g_queueSerial{0};   /* bumped by each PaOboe_SetOutputQueueBursts */
+
+static bool TuneOutput(AudioStream *stream, unsigned defaultBursts) {
+    static AudioStream *s_stream = nullptr;
+    static int s_xruns = 0, s_serial = -1;
+    static int64_t s_written = 0;
+    const int burst = std::max(1, stream->getFramesPerBurst());
+    const int64_t written = stream->getFramesWritten();
+    /* a new stream (opened again, maybe at the old one's address; or reopened on a new route) */
+    if (stream != s_stream || !g_output.open || written < s_written) {
+        s_stream = stream;
+        s_xruns = 0;
+        s_serial = -1;
+        auto x = stream->getXRunCount();
+        if (x) {
+            s_xruns = x.value();
+        }
+        g_output.mmap = stream->getAudioApi() == AudioApi::AAudio ? (OboeExtensions::isMMapUsed(stream) ? 1 : 0) : 0;
+        g_output.exclusive = stream->getSharingMode() == SharingMode::Exclusive ? 1 : 0;
+        g_output.aaudio = stream->getAudioApi() == AudioApi::AAudio ? 1 : 0;
+        g_output.sampleRate = stream->getSampleRate();
+        g_output.burst = burst;
+        g_output.callback = std::max(0, stream->getFramesPerDataCallback());
+        g_output.capacity = stream->getBufferCapacityInFrames();
+        g_output.deviceId = stream->getDeviceId();
+        g_output.xruns = 0;
+        g_output.open = 1;
+    }
+    const int serial = g_queueSerial.load();
+    if (serial != s_serial) {
+        s_serial = serial;
+        const int bursts = g_queueBursts.load();
+        stream->setBufferSizeInFrames(burst * (bursts > 0 ? bursts : static_cast<int>(defaultBursts)));
+    }
+    bool underrun = false;
+    auto x = stream->getXRunCount();
+    if (x && x.value() > s_xruns) {
+        underrun = true;
+        g_output.xruns += x.value() - s_xruns;
+        s_xruns = x.value();
+        const int size = stream->getBufferSizeInFrames();
+        if (size + burst <= stream->getSampleRate() / 20) {
+            stream->setBufferSizeInFrames(size + burst);
+        }
+    }
+    g_output.size = stream->getBufferSizeInFrames();
+    s_written = written;
+    return underrun;
+}
+
+void PaOboe_GetOutputStatus(PaOboe_OutputStatus *status) {
+    status->open = g_output.open;
+    status->mmap = g_output.mmap;
+    status->exclusive = g_output.exclusive;
+    status->aaudio = g_output.aaudio;
+    status->sampleRate = g_output.sampleRate;
+    status->framesPerBurst = g_output.burst;
+    status->framesPerCallback = g_output.callback;
+    status->bufferSizeFrames = g_output.size;
+    status->bufferCapacityFrames = g_output.capacity;
+    status->xruns = g_output.xruns;
+    status->deviceId = g_output.deviceId;
+}
+
+void PaOboe_SetOutputQueueBursts(int bursts) {
+    g_queueBursts = std::max(0, bursts);
+    ++g_queueSerial;
+}
