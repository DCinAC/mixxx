+/**
+ * \brief  ZyDeck: the output stream as it runs (PaOboe_GetOutputStatus). Its queue (bufferSizeFrames, how far ahead of
+ *          the hardware it's kept filled) starts at PaOboe_SetOutputQueueBursts' size and grows a burst at each underrun,
+ *          as Oboe's LatencyTuner does; each underrun also reaches the stream callback as paOutputUnderflow.
+ */
+typedef struct PaOboe_OutputStatus {
+    int open;                   /* an output stream is running */
+    int mmap;                   /* 1: straight to the hardware (AAudio MMAP); 0: through Android's mixer; -1: unknown */
+    int exclusive;              /* 1: exclusive sharing mode */
+    int aaudio;                 /* 1: AAudio; 0: OpenSL ES */
+    int sampleRate;
+    int framesPerBurst;
+    int framesPerCallback;      /* 0: AAudio's choice */
+    int bufferSizeFrames;
+    int bufferCapacityFrames;
+    int xruns;                  /* underruns since it opened */
+    int deviceId;
+} PaOboe_OutputStatus;
+
+void PaOboe_GetOutputStatus(PaOboe_OutputStatus *status);
+
+/**
+ * \brief  ZyDeck: the output queue in bursts, for the stream open now (applied at its next callback) and the next ones
+ *          (0: PaOboe_SetNumberOfBuffers' count). It can be set at any time.
+ */
+void PaOboe_SetOutputQueueBursts(int bursts);
