+/* ZyDeck: when the output is heard (PaOboe_GetOutputPresentationDelay). The stream's presentation clock: frame f is heard
+ * at origin + f / rate (CLOCK_MONOTONIC, seconds), from a fresh AAudio timestamp every 8 callbacks, eased, and taken as
+ * it is when it jumps (the first, or a new route). */
+static std::atomic<double> g_outputPresentationDelay{-1.0};
+
+static void MeasurePresentationDelay(AudioStream *stream) {
+    static AudioStream *s_stream = nullptr;
+    static double s_origin = 0;
+    static bool s_known = false;
+    static unsigned s_tick = 0;
+    if (stream->getAudioApi() != AudioApi::AAudio) {
+        return;
+    }
+    if (stream != s_stream) {
+        s_stream = stream;
+        s_known = false;
+        s_tick = 0;
+    }
+    const double rate = stream->getSampleRate();
+    if (rate <= 0) {
+        return;
+    }
+    if ((s_tick++ & 7) == 0) {
+        auto ts = stream->getTimestamp(CLOCK_MONOTONIC);
+        if (ts) {
+            const double origin = ts.value().timestamp / 1e9 - ts.value().position / rate;
+            if (!s_known || std::fabs(origin - s_origin) > 0.02) {
+                s_origin = origin;
+                s_known = true;
+            } else {
+                s_origin += (origin - s_origin) * 0.05;
+            }
+        }
+    }
+    if (!s_known) {
+        return;
+    }
+    struct timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    const double delay = s_origin + stream->getFramesWritten() / rate - (now.tv_sec + now.tv_nsec / 1e9);
+    if (delay > 0 && delay < 2.0) {
+        g_outputPresentationDelay.store(delay, std::memory_order_relaxed);
+    }
+}
+
+double PaOboe_GetOutputPresentationDelay(void) {
+    return g_outputPresentationDelay.load(std::memory_order_relaxed);
+}
